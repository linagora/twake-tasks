{
  "name": "@twake-tasks/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "stack:up": "./stack.sh up",
    "stack:down": "./stack.sh down",
    "lint": "rs lint -c ../rstack.config.mjs",
    "format": "rs fmt -c ../rstack.config.mjs",
    "format:check": "rs fmt --check -c ../rstack.config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
