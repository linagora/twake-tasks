{
  "name": "Project",
  "name_prefix": "Twake",
  "slug": "project",
  "type": "webapp",
  "licence": "AGPL-3.0",
  "icon": "icon.svg",
  "categories": ["cozy"],
  "source": "https://github.com/linagora/twake-tasks",
  "editor": "Cozy",
  "developer": {
    "name": "Twake Workplace",
    "url": "https://twake.app"
  },
  "standalone": true,
  "client_url_flag": "project.embedded-app-url",
  "permissions": {
    "banners": {
      "description": "Required by the cozy-bar to display platform messages",
      "type": "io.cozy.banners",
      "verbs": ["GET", "PUT"]
    },
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": ["GET"]
    },
    "settings": {
      "description": "Required by the cozy-bar to display storage usage",
      "type": "io.cozy.settings",
      "verbs": ["GET"]
    },
    "files": {
      "description": "Required to get shortcuts, to pick the files of Twake Drive linked to a task, and to put there the files added to a task",
      "type": "io.cozy.files",
      "verbs": ["GET", "POST"]
    },
    "sharings": {
      "description": "Required to put the files of a space's tasks in its team drive",
      "type": "io.cozy.sharings",
      "verbs": ["GET"]
    },
    "permissions": {
      "description": "Required to share the files added to a task by a link",
      "type": "io.cozy.permissions",
      "verbs": ["POST"]
    }
  }
}
