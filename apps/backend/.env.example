RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Exchange and queue names, when the broker's differ from these defaults
# RABBITMQ_SPACE_EXCHANGE=space
# RABBITMQ_B2B_EXCHANGE=b2b
# RABBITMQ_AUTH_EXCHANGE=auth
# RABBITMQ_SETTINGS_EXCHANGE=settings
# RABBITMQ_ACTIVITY_EXCHANGE=activity
# RABBITMQ_QUEUE=twake-tasks
# RABBITMQ_OLD_QUEUE=platform.all.twake-tasks
# RABBITMQ_DEAD_LETTER_EXCHANGE=twake-tasks.dlx
# Events each replica handles at once
# RABBITMQ_CONCURRENCY=5
DATABASE_URL=postgres://twake_tasks:twake_tasks@localhost:5432/twake_tasks
# The role that owns the tables and migrates them, DATABASE_URL's when unset
DATABASE_MIGRATION_URL=postgres://twake_tasks_owner:twake_tasks_owner@localhost:5432/twake_tasks
# Database connections each replica keeps at most
# DATABASE_POOL_MAX=20
# Postgres cancels a request's statement past this, 0 for never
# DATABASE_STATEMENT_TIMEOUT_MS=5000
# Fewest characters a search takes
# SEARCH_MIN_LENGTH=2
HTTP_PORT=8080
# Nothing proxies the backend in development
HTTP_TRUSTED_PROXY_HOPS=0
# Rate limit counters shared by the replicas, in memory without it
# REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
LOG_LEVEL=info
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# A project for each TwakeSpace space, repaired nightly from ldap-rest
# SPACE_INTEGRATION=true
# LDAP_REST_URL=http://localhost:8081
# LDAP_REST_SECRET=
# Notifications and board invitations are emailed only when this is set, e.g. to a local mailpit.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Twake Project <tasks@twake.app>
