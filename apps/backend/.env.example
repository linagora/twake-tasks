KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY=plaintext
KAFKA_GROUP_ID=twake-tasks
DATABASE_URL=postgres://twake_tasks:twake_tasks@localhost:5432/twake_tasks
HTTP_PORT=8080
LOG_LEVEL=info
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=

