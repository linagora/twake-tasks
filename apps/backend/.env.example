KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY=plaintext
KAFKA_GROUP_ID=twake-tasks
DATABASE_URL=postgres://twake_tasks:twake_tasks@localhost:5432/twake_tasks
HTTP_PORT=8080
APP_URL=http://localhost:5173
LOG_LEVEL=info
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# The nightly repair of spaces and their members, with ldap-rest's HMAC service id
LDAP_REST_URL=http://localhost:8081
LDAP_REST_SECRET=
# Notifications are emailed only when this is set, e.g. to a local mailpit.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Twake Tasks <tasks@twake.app>

